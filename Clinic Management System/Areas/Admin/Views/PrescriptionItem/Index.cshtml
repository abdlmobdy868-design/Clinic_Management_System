@model IEnumerable<ClinicManagementSystem.Models.PrescriptionItems>

@{
    ViewData["Title"] = "Prescription Items";
    int? prescriptionId = ViewBag.PrescriptionId as int?;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-capsule me-2"></i>Prescription Items
            </h2>
            <p class="text-muted mb-0">
                @(prescriptionId.HasValue ? $"Managing items for Prescription #{prescriptionId}" : "All prescribed medications across records")
            </p>
        </div>
        <div>
            @if (prescriptionId.HasValue)
            {
                <a asp-controller="Prescription" asp-action="Details" asp-route-id="@prescriptionId" class="btn btn-outline-secondary rounded-pill me-2">
                    <i class="bi bi-arrow-left me-1"></i> Back to Prescription
                </a>
            }
            <a asp-action="Create" asp-route-prescriptionId="@prescriptionId" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill">
                <i class="bi bi-plus-lg me-1"></i> Add Medication
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4">Item ID</th>
                            <th>Prescription</th>
                            <th>Patient Name</th>
                            <th>Medicine Name</th>
                            <th>Dosage</th>
                            <th>Duration</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">No medication items found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4"><span class="badge bg-light text-dark border">#@item.Id</span></td>
                                    <td><span class="badge bg-info-subtle text-info-emphasis rounded-pill px-3">#@item.PrescriptionId</span></td>
                                    <td class="fw-bold text-dark">@(item.Prescription?.MedicalRecord?.Patient?.Name ?? "N/A")</td>
                                    <td class="fw-bold text-primary">@item.MedicineName</td>
                                    <td><span class="badge bg-success-subtle text-success fs-6 px-3 py-1 rounded-pill">@item.Dosage x Daily</span></td>
                                    <td class="text-muted">@item.Duration</td>
                                    <td class="text-center pe-4">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1 rounded-pill px-3">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this medication?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>