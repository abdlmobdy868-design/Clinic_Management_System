@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Patients";
}
<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Patients</h3>
        <a asp-action="Create" class="btn btn-primary">+ Add Patient</a>
    </div>
    <table class="table">
        <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.FullName</td>
                    <td>@d.Email</td>
                 
                    <td>@d.PhoneNumber</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-warning">Update</a>
                        <a asp-action="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this patient?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>