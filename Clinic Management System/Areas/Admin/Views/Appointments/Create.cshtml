@model Appointment
<div class="card p-4">
    <h3>Add Appointment</h3>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <label>Doctor</label>
        <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-control mb-2">
            <option value="">-- Select Doctor --</option>
        </select>

        <label>Patient</label>
        <select asp-for="PatientId" asp-items="ViewBag.Patients" class="form-control mb-2">
            <option value="">-- Select Patient --</option>
        </select>

        <label>Department / القسم</label>
        <select asp-for="ClinicId" asp-items="ViewBag.Clinics" class="form-control mb-2">
            <option value="">-- choose a department --</option>
        </select>

        <label>Date & Time</label>
        <input asp-for="AppointmentDateTime" type="datetime-local" class="form-control mb-3" required />


        <button type="submit" class="btn btn-primary">Save Booking</button>
    </form>
</div>