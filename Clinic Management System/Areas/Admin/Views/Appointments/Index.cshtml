@model List<Appointment>
<div class="card p-4">
    <div class="d-flex justify-content-between mb-3">
        <h3>Appointments</h3>
        <a asp-action="Create" class="btn btn-primary">+ Add Appointment</a>
    </div>
    <table class="table">
        <thead><tr><th>Doctor</th><th>Patient</th><th>Date</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Doctor?.Name</td>
                    <td>@(a.Patient?.Name ?? "no patient")</td>
                    <td>@a.AppointmentDateTime</td>
                    <td>@a.Status</td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-warning">Update</a>
                        <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this appointment?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>