@using ClinicManagementSystem.Utilities
@model ClinicManagementSystem.ViewModel.AppointmentsIndexVM
@{
    ViewData["Title"] = "Appointments";
}

<div class="card p-4 border-0 shadow-sm">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h3 class="mb-0">Appointments</h3>
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Create slots</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-sm btn-outline-success" asp-action="Index" asp-route-view="free">Free slots: @Model.FreeCount</a>
        <a class="btn btn-sm btn-outline-warning" asp-action="Index" asp-route-status="Pending" asp-route-view="booked">Waiting payment: @Model.PendingCount</a>
        <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-status="Confirmed">Confirmed: @Model.ConfirmedCount</a>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-status="Completed">Completed: @Model.CompletedCount</a>
        <a class="btn btn-sm btn-outline-danger" asp-action="Index" asp-route-status="Cancelled">Cancelled: @Model.CancelledCount</a>
    </div>

    <form method="get" asp-action="Index" class="row g-2 align-items-end mb-4">
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Show</label>
            <select name="view" class="form-select form-select-sm">
                <option value="" selected="@(string.IsNullOrEmpty(Model.View))">All</option>
                <option value="free" selected="@(Model.View == "free")">Free slots</option>
                <option value="booked" selected="@(Model.View == "booked")">Booked</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">Any</option>
                @foreach (var s in Enum.GetValues<AppointmentStatus>())
                {
                    <option value="@s" selected="@(Model.Status == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-1">Doctor</label>
            <select name="doctorId" class="form-select form-select-sm" asp-items="Model.Doctors">
                <option value="">Any doctor</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Date</label>
            <input type="date" name="date" class="form-control form-control-sm" value="@(Model.Date?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button class="btn btn-sm btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>

    @if (!Model.Rows.Any())
    {
        <div class="text-center text-muted py-5">
            No appointments match. Use <b>Create slots</b> to add free times for a doctor.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>#</th><th>Doctor</th><th>Patient</th><th>Clinic</th><th>When</th><th>Fee</th><th>Status</th><th style="min-width:330px">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        var badge = r.Status switch
                        {
                            AppointmentStatus.Pending => "warning text-dark",
                            AppointmentStatus.Confirmed => "success",
                            AppointmentStatus.Completed => "primary",
                            _ => "danger"
                        };
                        <tr>
                            <td>@r.Id</td>
                            <td>@r.DoctorName</td>
                            <td>@(r.PatientName ?? (r.IsFree ? "Free slot" : "-"))</td>
                            <td>@(r.ClinicName ?? "-")</td>
                            <td>@r.Start.ToString("ddd dd MMM yyyy")<br /><small class="text-muted">@r.Start.ToString("hh:mm tt") - @r.End.ToString("hh:mm tt")</small></td>
                            <td>@r.Price.ToString("N0")</td>
                            <td>
                                @if (r.IsFree)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis border">Free</span>
                                }
                                else
                                {
                                    <span class="badge bg-@badge">@r.Status</span>
                                    @if (r.IsPaid)
                                    {
                                        <span class="badge bg-info text-dark">Paid</span>
                                    }
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1 align-items-center">
                                    <form asp-action="ChangeStatus" method="post" class="d-inline-flex gap-1">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <select name="status" class="form-select form-select-sm" style="width:120px">
                                            @foreach (var s in Enum.GetValues<AppointmentStatus>())
                                            {
                                                <option value="@s" selected="@(r.Status == s)">@s</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Set</button>
                                    </form>
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-warning">Edit</a>
                                    @if (r.PatientId != null && !r.HasRecord && r.Status != AppointmentStatus.Cancelled)
                                    {
                                        <a asp-controller="MedicalRecord" asp-action="Create" asp-route-appointmentId="@r.Id" class="btn btn-sm btn-success">Add record</a>
                                    }
                                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this appointment?')">
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <small class="text-muted">Showing up to 300 appointments, earliest first.</small>
    }
</div>
