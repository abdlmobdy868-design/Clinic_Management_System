<!DOCTYPE html>
<html>
<head>
    <title>ClinicMS - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
            body {
                background: #eaf6ff;
                font-family: 'Segoe UI', sans-serif;
                margin: 0
            }

            .sidebar {
                width: 250px;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background: linear-gradient(180deg,#0a6fbe,#00c9c8);
                padding: 20px 15px;
                color: white;
                display: flex;
                flex-direction: column
            }

                .sidebar .brand {
                    font-size: 22px;
                    font-weight: 800;
                    margin-bottom: 30px
                }

                .sidebar a {
                    color: rgba(255,255,255,0.85);
                    text-decoration: none;
                    padding: 11px 15px;
                    border-radius: 10px;
                    display: flex;
                    gap: 10px;
                    margin-bottom: 5px;
                    font-size: 14px
                }

                    .sidebar a.active, .sidebar a:hover {
                        background: white;
                        color: #0a6fbe;
                        font-weight: 600
                    }

            .main {
                margin-left: 250px;
                padding: 25px 30px
            }
            /* الكروت اللي في الصورة */
            .stat-card {
                background: white;
                border-radius: 14px;
                padding: 18px 20px;
                display: flex;
                gap: 15px;
                align-items: center;
                box-shadow: 0 2px 12px rgba(0,0,0,.04);
                height: 90px
            }

            .stat-icon {
                width: 48px;
                height: 48px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px
            }

            .i-blue {
                background: #e6f0ff;
                color: #0d6efd
            }

            .i-teal {
                background: #e0f7f5;
                color: #0d9f9a
            }

            .i-green {
                background: #e6f9ed;
                color: #16a34a
            }

            .i-orange {
                background: #fff4e6;
                color: #f59e0b
            }

            .i-red {
                background: #ffe6e9;
                color: #dc3545
            }

            .i-purple {
                background: #f3e6ff;
                color: #8b5cf6
            }

            .stat-value {
                font-size: 22px;
                font-weight: 700;
                line-height: 1
            }

            .stat-label {
                font-size: 12px;
                color: #6c757d;
                margin-top: 4px
            }
            /* البانلز */
            .panel {
                background: white;
                border-radius: 14px;
                padding: 20px;
                box-shadow: 0 2px 12px rgba(0,0,0,.04);
                height: 100%
            }

            .panel-title {
                font-weight: 700;
                font-size: 14px;
                margin-bottom: 15px
            }

            .chart-box {
                height: 260px
            }

                .chart-box.sm {
                    height: 200px
                }

            .table-clean th {
                font-size: 12px;
                color: #6c757d;
                font-weight: 600;
                border: 0
            }

            .table-clean td {
                font-size: 13px;
                vertical-align: middle;
                padding: 10px 8px
            }

            .badge-status {
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 11px
            }

            .st-Pending {
                background: #fff4e6;
                color: #f59e0b
            }

            .st-Completed {
                background: #e6f9ed;
                color: #16a34a
            }

            .st-Cancelled {
                background: #ffe6e9;
                color: #dc3545
            }

            .empty {
                text-align: center;
                padding: 40px;
                color: #9ca3af
            }

            .rating {
                color: #f59e0b
            }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="brand"><i class="fa-solid fa-heart-pulse"></i> ClinicMS</div>

        <a class="active" href="/Admin/Dashboard"><i class="fa-solid fa-table-columns"></i> Dashboard</a>
        <a href="/Admin/Users"><i class="fa-solid fa-users"></i> Users</a>
        <a href="/Admin/Doctors"><i class="fa-solid fa-user-doctor"></i> Doctors</a>
        <a href="/Admin/Departments"><i class="fa-solid fa-building"></i> Departments</a>
        <a href="/Admin/Clinics"><i class="fa-solid fa-calendar-check"></i> Clinic</a>

        <a href="/Admin/Appointments"><i class="fa-solid fa-calendar-check"></i> Appointments</a>
        <a href="/Admin/Patients"><i class="fa-solid fa-user-injured"></i> Patients</a>
        <a href="/Admin/Payments"><i class="fa-solid fa-credit-card"></i> Payments</a>
        <div style="flex:1"></div>
        <a href="/Account/Logout" style="background:rgba(255,255,255,0.15)"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
    </div>
    <div class="main">
        @RenderBody()
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>