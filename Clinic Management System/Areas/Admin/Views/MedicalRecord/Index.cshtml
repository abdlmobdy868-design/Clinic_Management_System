@model IEnumerable<ClinicManagementSystem.Models.MedicalRecord>

@{
    ViewData["Title"] = "Medical Records";
}
<head>
    <link rel="stylesheet" href="~/css/medical-record-custom.css" asp-append-version="true" />
</head>
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-journal-medical me-2"></i>Medical Records</h2>
            <p class="text-muted mb-0">Manage patient consultations, diagnoses, and medical histories</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill">
            <i class="bi bi-plus-lg me-1"></i> New Record
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4">Record ID</th>
                            <th>Patient Name</th>
                            <th>Doctor</th>
                            <th>Diagnosis</th>
                            <th>Date</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">No medical records found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4"><span class="badge bg-light text-dark border">#@item.Id</span></td>
                                    <td class="fw-bold text-dark">@(item.Patient?.Name ?? "N/A")</td>
                                    <td>Dr. @(item.Doctor?.Name ?? "N/A")</td>
                                    <td><span class="text-truncate d-inline-block" style="max-width: 220px;">@item.Diagnosis</span></td>
                                    <td class="text-muted">@item.CreatedAt.ToString("yyyy-MM-dd | hh:mm tt")</td>
                                    <td class="text-center pe-4">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1 rounded-pill px-3">
                                            <i class="bi bi-eye me-1"></i> View
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1 rounded-pill px-3">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this record?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>