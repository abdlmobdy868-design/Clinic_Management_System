@using ClinicManagementSystem.Utilities
@model IEnumerable<ClinicManagementSystem.Models.Payment>
@{
    ViewData["Title"] = "Payments List";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-credit-card me-2"></i>Payments & Transactions</h2>
            <p class="text-muted mb-0">Manage patient billing, payment status, and invoices</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill">
            <i class="bi bi-plus-lg me-1"></i> Record Payment
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4">Payment ID</th>
                            <th>Patient Name</th>
                            <th>Appointment</th>
                            <th>Amount</th>
                            <th>Payment Method</th>
                            <th>Status</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">No payment records found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4"><span class="badge bg-light text-dark border">#@item.Id</span></td>
                                    <td class="fw-bold text-dark">@(item.Patient?.Name ?? "N/A")</td>
                                    <td><span class="badge bg-info-subtle text-info-emphasis rounded-pill px-3">#@item.AppointmentId</span></td>
                                    <td class="fw-bold text-success">@item.Amount.ToString("C")</td>
                                    <td><span class="badge bg-light text-dark border px-3 py-1">@item.PaymentMethod</span></td>
                                    <td>
                                        @switch (item.PaymentStatus)
                                        {
                                            case PaymentStatus.Paid:
                                                <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill"><i class="bi bi-check-circle me-1"></i>Paid</span>
                                                break;
                                            case PaymentStatus.Pending:
                                                <span class="badge bg-warning-subtle text-warning px-3 py-1 rounded-pill"><i class="bi bi-clock me-1"></i>Pending</span>
                                                break;
                                            case PaymentStatus.Failed:
                                                <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill"><i class="bi bi-x-circle me-1"></i>Failed</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill">@item.PaymentStatus</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1 rounded-pill px-3">
                                            <i class="bi bi-eye me-1"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1 rounded-pill px-3">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this payment record?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>