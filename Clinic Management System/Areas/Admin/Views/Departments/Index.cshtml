@model List<ClinicManagementSystem.Models.DepartmentVM>
@{
    ViewData["Title"] = "Departments";
}
<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Departments</h3>
        <a asp-action="Create" class="btn btn-primary">+ Add Department</a>
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    <table class="table table-clean">
        <thead>
            <tr>
                <th>Name</th>
                <th>Clinic</th>
                <th>Doctors Count</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.ClinicName</td>
                    <td>@item.DoctorsCount</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Update</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
