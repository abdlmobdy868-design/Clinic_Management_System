@model ClinicManagementSystem.Models.Prescription

@{
    ViewData["Title"] = "Prescription Details";
    var items = ViewBag.PrescriptionItems as IEnumerable<ClinicManagementSystem.Models.PrescriptionItems>;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0"><i class="bi bi-prescription2 me-2"></i>Prescription #@Model.Id</h2>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 me-2">Back to List</a>
            <button onclick="window.print();" class="btn btn-success rounded-pill px-4">
                <i class="bi bi-printer me-1"></i> Print
            </button>
        </div>
    </div>

    <!-- Header Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <span class="text-muted d-block small">Patient Name</span>
                    <strong class="fs-5 text-dark">@(Model.MedicalRecord?.Patient?.Name ?? "N/A")</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted d-block small">Attending Doctor</span>
                    <strong class="fs-5 text-dark">Dr. @(Model.MedicalRecord?.Doctor?.Name ?? "N/A")</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted d-block small">Prescription Date</span>
                    <strong class="fs-6 text-dark">@Model.Date.ToString("MMMM dd, yyyy - hh:mm tt")</strong>
                </div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="col-12 mt-3">
                        <span class="text-muted d-block small">Instructions / Notes</span>
                        <p class="mb-0 text-dark">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Prescribed Medications Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-primary text-white py-3 rounded-top-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="bi bi-capsule me-2"></i>Prescribed Medications</h5>
            <a asp-controller="PrescriptionItem" asp-action="Create" asp-route-prescriptionId="@Model.Id" class="btn btn-sm btn-light rounded-pill px-3">
                <i class="bi bi-plus-lg me-1"></i> Add Medication
            </a>
        </div>
        <div class="card-body p-0">
            @if (items == null || !items.Any())
            {
                <div class="p-4 text-center text-muted">No medications added to this prescription yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Medicine Name</th>
                                <th>Dosage</th>
                                <th>Duration</th>
                                <th class="text-center pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">@item.MedicineName</td>
                                    <td><span class="badge bg-success-subtle text-success fs-6 px-3 py-1 rounded-pill">@item.Dosage x Daily</span></td>
                                    <td class="text-muted">@item.Duration</td>
                                    <td class="text-center pe-4">
                                        <a asp-controller="PrescriptionItem" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>