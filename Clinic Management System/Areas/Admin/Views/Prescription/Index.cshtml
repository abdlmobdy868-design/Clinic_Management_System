@model IEnumerable<ClinicManagementSystem.Models.Prescription>

@{
    ViewData["Title"] = "Prescriptions List";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-file-earmark-medical me-2"></i>Prescriptions</h2>
            <p class="text-muted mb-0">Manage written medical prescriptions and patient medication orders</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill">
            <i class="bi bi-plus-lg me-1"></i> New Prescription
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4">Prescription ID</th>
                            <th>Medical Record</th>
                            <th>Patient Name</th>
                            <th>Doctor</th>
                            <th>Date</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">No prescriptions found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4"><span class="badge bg-light text-dark border">#@item.Id</span></td>
                                    <td><span class="badge bg-info-subtle text-info-emphasis rounded-pill px-3">#@item.MedicalRecordId</span></td>
                                    <td class="fw-bold text-dark">@(item.MedicalRecord?.Patient?.Name ?? "N/A")</td>
                                    <td>Dr. @(item.MedicalRecord?.Doctor?.Name ?? "N/A")</td>
                                    <td class="text-muted">@item.Date.ToString("yyyy-MM-dd | hh:mm tt")</td>
                                    <td class="text-center pe-4">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1 rounded-pill px-3">
                                            <i class="bi bi-eye me-1"></i> View & Items
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1 rounded-pill px-3">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this prescription?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>