@model ClinicManagementSystem.Models.ApplicationUser
<div class="card p-4">
    <h3>Create User</h3>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <label>Full Name</label>
        <input asp-for="FullName" name="fullName" class="form-control mb-2" required />

        <label>Email</label>
        <input name="email" type="email" class="form-control mb-2" required />

        <label>Phone</label>
        <input name="phone" class="form-control mb-2" />

        <label>Password</label>
        <input name="password" type="password" class="form-control mb-2" required />
        

        <label class="mt-2">Role</label>
        <select name="role" class="form-control mb-3">
            <option value="Doctor">Doctor</option>
            <option value="Patient">Patient</option>
            <option value="Receptionist">Receptionist</option>
            <option value="Admin">Admin</option>
        </select>

        <button type="submit" class="btn btn-primary">Create</button>
    </form>
</div>