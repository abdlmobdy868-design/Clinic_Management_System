@model IEnumerable<ClinicManagementSystem.Models.labResult>

@{
    ViewData["Title"] = "Lab Results Log";
}
<head>
    <link rel="stylesheet" href="~/css/lab-custom.css" asp-append-version="true" />
</head>
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-clipboard2-pulse me-2"></i>Patient Lab Results</h2>
            <p class="text-muted mb-0">View uploaded laboratory result files and records</p>
        </div>
        <a asp-action="UploadResult" class="btn btn-success px-4 py-2 shadow-sm rounded-pill">
            <i class="bi bi-upload me-1"></i> Upload New Result
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4">Medical Record ID</th>
                            <th>Patient Name</th>
                            <th>Test Type</th>
                            <th>Date</th>
                            <th class="text-center pe-4">File / Document</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">No lab results found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var res in Model)
                            {
                                <tr>
                                    <td class="ps-4"><span class="badge bg-light text-dark border">#@res.MedicalRecordId</span></td>
                                    <td class="fw-bold text-dark">@(res.MedicalRecord?.Patient?.Name ?? "N/A")</td>
                                    <td><span class="badge bg-info-subtle text-info-emphasis rounded-pill px-3 py-1">@(res.LabTest?.Name ?? "N/A")</span></td>
                                    <td class="text-muted">@res.Date.ToString("yyyy-MM-dd | hh:mm tt")</td>
                                    <td class="text-center pe-4">
                                        @if (!string.IsNullOrEmpty(res.ResultFileUrl))
                                        {
                                            <a href="@res.ResultFileUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> View / Download
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-7">No file attached</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>