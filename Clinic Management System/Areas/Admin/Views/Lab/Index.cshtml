@model IEnumerable<ClinicManagementSystem.Models.LabTest>

@{
    ViewData["Title"] = "Lab Tests Management";
}
<head>
    <link rel="stylesheet" href="~/css/lab-custom.css" asp-append-version="true" />
</head>
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-flask me-2"></i>Medical Lab Tests</h2>
            <p class="text-muted mb-0">Manage available laboratory tests and pricing</p>
        </div>
        <a asp-action="CreateTest" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill">
            <i class="bi bi-plus-lg me-1"></i> Add New Test
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4">Test Name</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">No lab tests registered yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@item.Name</td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                                    <td><span class="badge bg-success-subtle text-success fs-6 px-3 py-2 rounded-pill">@item.Price.ToString("C")</span></td>
                                    <td class="text-center pe-4">
                                        <a asp-action="EditTest" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1 rounded-pill px-3">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <a asp-action="DeleteTest" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Are you sure you want to delete this test?');">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>