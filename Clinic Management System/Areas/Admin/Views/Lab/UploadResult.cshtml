@model ClinicManagementSystem.Models.labResult

@{
    ViewData["Title"] = "Upload Lab Result";
}
<head>
    <link rel="stylesheet" href="~/css/lab-custom.css" asp-append-version="true" />
</head>
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-success text-white py-3 rounded-top-4">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-cloud-upload me-2"></i>Upload Patient Lab Result</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="UploadResult" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Select Medical Record / Patient</label>
                            <select asp-for="MedicalRecordId" class="form-select rounded-3" asp-items="ViewBag.MedicalRecords">
                                <option value="">-- Select Patient Medical Record --</option>
                            </select>
                            <span asp-validation-for="MedicalRecordId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Test Type</label>
                            <select asp-for="LabTestId" class="form-select rounded-3" asp-items="ViewBag.LabTests">
                                <option value="">-- Select Lab Test --</option>
                            </select>
                            <span asp-validation-for="LabTestId" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Result File (PDF / Image)</label>
                            <input type="file" name="resultFile" class="form-control rounded-3" accept=".pdf,.png,.jpg,.jpeg" />
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Results" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-success rounded-pill px-4">Upload Result</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>