@model ClinicManagementSystem.Models.Appointment

@{
    ViewData["Title"] = "Medical Record & Prescription";
    Layout = "/Areas/Doctor/Views/_DoctorLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h3 class="mb-0"><i class="fas fa-file-medical-alt me-2"></i> Patient Examination & Prescription</h3>
                </div>
                <div class="card-body p-4">

                    <!-- معلومات المريض السريعة -->
                    <div class="alert alert-light border mb-4">
                        <h5 class="text-primary fw-bold mb-2"><i class="fas fa-user-circle me-1"></i> Patient Details</h5>
                        <div class="row">
                            <div class="col-md-4"><strong>Name:</strong> @(Model.Patient?.Name ?? "N/A")</div>
                            <div class="col-md-4"><strong>Phone:</strong> @(Model.Patient?.Phone ?? "N/A")</div>
                            <div class="col-md-4"><strong>Appointment Time:</strong> @Model.StartTime.ToString("dd MMM yyyy - hh:mm tt")</div>
                        </div>
                    </div>

                    <form asp-action="CreateMedicalRecord" method="post">
                        <input type="hidden" name="appointmentId" value="@Model.Id" />

                        <!-- قسم السجل الطبي -->
                        <h5 class="text-secondary fw-bold mb-3"><i class="fas" style="font-size:1rem;">📋</i> Medical Record Details</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Diagnosis <span class="text-danger">*</span></label>
                                <textarea name="diagnosis" class="form-control" rows="3" required placeholder="Enter primary diagnosis..."></textarea>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Symptoms</label>
                                <input type="text" name="symptoms" class="form-control" placeholder="e.g. Fever, Cough, Headache" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Vital Signs</label>
                                <input type="text" name="vitalSigns" class="form-control" placeholder="e.g. BP: 120/80, Temp: 37°C" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Medical History</label>
                                <textarea name="medicalHistory" class="form-control" rows="2" placeholder="Any relevant past medical history..."></textarea>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-semibold">General Notes</label>
                                <textarea name="recordNotes" class="form-control" rows="2" placeholder="Additional notes..."></textarea>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- قسم الروشتة والأدوية (Dynamic Rows) -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="text-secondary fw-bold mb-0"><i class="fas fa-pills me-1"></i> Prescription & Medicines</h5>
                            <button type="button" id="addMedicineBtn" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-plus me-1"></i> Add Medicine
                            </button>
                        </div>

                        <div id="medicinesContainer">
                            <!-- صف دواء افتراضي أولي -->
                            <div class="row g-2 medicine-row mb-2 align-items-center">
                                <div class="col-md-5">
                                    <input type="text" name="medicineNames" class="form-control" placeholder="Medicine Name & Strength" required />
                                </div>
                                <div class="col-md-3">
                                    <input type="number" name="dosages" class="form-control" placeholder="Dosage (e.g. 1)" min="1" required />
                                </div>
                                <div class="col-md-3">
                                    <input type="text" name="durations" class="form-control" placeholder="Duration (e.g. 5 Days)" required />
                                </div>
                                <div class="col-md-1 text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-medicine" disabled>
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label fw-semibold">Prescription Notes / Instructions</label>
                            <textarea name="prescriptionNotes" class="form-control" rows="2" placeholder="e.g. Take after meals..."></textarea>
                        </div>

                        <!-- أزرار الحفظ -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="MyAppointments" class="btn btn-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="fas fa-save me-1"></i> Save Record & Rx
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // كود JavaScript لإضافة وحذف صفوف الأدوية ديناميكياً
        document.getElementById('addMedicineBtn').addEventListener('click', function () {
            const container = document.getElementById('medicinesContainer');
            const newRow = document.createElement('div');
            newRow.className = 'row g-2 medicine-row mb-2 align-items-center';
            newRow.innerHTML = `
                        <div class="col-md-5">
                            <input type="text" name="medicineNames" class="form-control" placeholder="Medicine Name & Strength" required />
                        </div>
                        <div class="col-md-3">
                            <input type="number" name="dosages" class="form-control" placeholder="Dosage (e.g. 1)" min="1" required />
                        </div>
                        <div class="col-md-3">
                            <input type="text" name="durations" class="form-control" placeholder="Duration (e.g. 5 Days)" required />
                        </div>
                        <div class="col-md-1 text-center">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-medicine">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    `;
            container.appendChild(newRow);
            updateRemoveButtons();
        });

        document.getElementById('medicinesContainer').addEventListener('click', function (e) {
            if (e.target.closest('.remove-medicine')) {
                e.target.closest('.medicine-row').remove();
                updateRemoveButtons();
            }
        });

        function updateRemoveButtons() {
            const rows = document.querySelectorAll('.medicine-row');
            rows.forEach((row, index) => {
                const btn = row.querySelector('.remove-medicine');
                if (rows.length === 1) {
                    btn.setAttribute('disabled', 'true');
                } else {
                    btn.removeAttribute('disabled');
                }
            });
        }
    </script>
}