@model ClinicManagementSystem.Models.MedicalRecord

@{
    ViewData["Title"] = "Edit Medical Record";
    Layout = "/Areas/Doctor/Views/_DoctorLayout.cshtml";
    var prescription = ViewBag.Prescription as ClinicManagementSystem.Models.Prescription;
    var prescriptionItems = ViewBag.PrescriptionItems as List<ClinicManagementSystem.Models.PrescriptionItems>;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-warning text-dark p-4 rounded-top-4">
                    <h3 class="mb-0"><i class="fas fa-edit me-2"></i> Edit Patient Examination & Prescription</h3>
                </div>
                <div class="card-body p-4">

                    <div class="alert alert-light border mb-4">
                        <h5 class="text-primary fw-bold mb-2"><i class="fas fa-user-circle me-1"></i> Patient Details</h5>
                        <div class="row">
                            <div class="col-md-4"><strong>Name:</strong> @(Model.Patient?.Name ?? "N/A")</div>
                            <div class="col-md-4"><strong>Phone:</strong> @(Model.Patient?.Phone ?? "N/A")</div>
                            <div class="col-md-4"><strong>Visit Date:</strong> @Model.CreatedAt.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>

                    <form asp-action="EditMedicalRecord" method="post">
                        <!-- 👈 حقل مخفي لإرسال الـ appointmentId للـ POST Controller -->
                        <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />

                        <!-- قسم السجل الطبي -->
                        <h5 class="text-secondary fw-bold mb-3"><i class="fas fa-clipboard-list me-1"></i> Medical Record Details</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Diagnosis <span class="text-danger">*</span></label>
                                <textarea name="diagnosis" class="form-control" rows="3" required>@Model.Diagnosis</textarea>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Symptoms</label>
                                <input type="text" name="symptoms" class="form-control" value="@Model.Symptoms" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Vital Signs</label>
                                <input type="text" name="vitalSigns" class="form-control" value="@Model.VitalSigns" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Medical History</label>
                                <textarea name="medicalHistory" class="form-control" rows="2">@Model.MedicalHistory</textarea>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-semibold">General Notes</label>
                                <textarea name="recordNotes" class="form-control" rows="2">@Model.Notes</textarea>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- قسم الأدوية والروشتة -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="text-secondary fw-bold mb-0"><i class="fas fa-pills me-1"></i> Prescription & Medicines</h5>
                            <button type="button" id="addMedicineBtn" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-plus me-1"></i> Add Medicine
                            </button>
                        </div>

                        <div id="medicinesContainer">
                            @if (prescriptionItems != null && prescriptionItems.Any())
                            {
                                foreach (var item in prescriptionItems)
                                {
                                    <div class="row g-2 medicine-row mb-2 align-items-center">
                                        <div class="col-md-5">
                                            <input type="text" name="medicineNames" class="form-control" value="@item.MedicineName" required />
                                        </div>
                                        <div class="col-md-3">
                                            <input type="number" name="dosages" class="form-control" value="@item.Dosage" min="1" required />
                                        </div>
                                        <div class="col-md-3">
                                            <input type="text" name="durations" class="form-control" value="@item.Duration" required />
                                        </div>
                                        <div class="col-md-1 text-center">
                                            <button type="button" class="btn btn-outline-danger btn-sm remove-medicine">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="row g-2 medicine-row mb-2 align-items-center">
                                    <div class="col-md-5">
                                        <input type="text" name="medicineNames" class="form-control" placeholder="Medicine Name & Strength" required />
                                    </div>
                                    <div class="col-md-3">
                                        <input type="number" name="dosages" class="form-control" placeholder="Dosage" min="1" required />
                                    </div>
                                    <div class="col-md-3">
                                        <input type="text" name="durations" class="form-control" placeholder="Duration" required />
                                    </div>
                                    <div class="col-md-1 text-center">
                                        <button type="button" class="btn btn-outline-danger btn-sm remove-medicine" disabled>
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-3">
                            <label class="form-label fw-semibold">Prescription Notes / Instructions</label>
                            <textarea name="prescriptionNotes" class="form-control" rows="2">@prescription?.Notes</textarea>
                        </div>

                        <!-- أزرار الحفظ والإلغاء -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="MyAppointments" class="btn btn-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-warning px-5 fw-semibold text-dark">
                                <i class="fas fa-save me-1"></i> Update Record & Rx
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // إضافة صف دواء جديد ديناميكياً
        document.getElementById('addMedicineBtn').addEventListener('click', function () {
            const container = document.getElementById('medicinesContainer');
            const newRow = document.createElement('div');
            newRow.className = 'row g-2 medicine-row mb-2 align-items-center';
            newRow.innerHTML = `
                <div class="col-md-5">
                    <input type="text" name="medicineNames" class="form-control" placeholder="Medicine Name & Strength" required />
                </div>
                <div class="col-md-3">
                    <input type="number" name="dosages" class="form-control" placeholder="Dosage" min="1" required />
                </div>
                <div class="col-md-3">
                    <input type="text" name="durations" class="form-control" placeholder="Duration" required />
                </div>
                <div class="col-md-1 text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm remove-medicine">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            `;
            container.appendChild(newRow);
            updateRemoveButtons();
        });

        // حذف صف الدواء
        document.getElementById('medicinesContainer').addEventListener('click', function (e) {
            if (e.target.closest('.remove-medicine')) {
                e.target.closest('.medicine-row').remove();
                updateRemoveButtons();
            }
        });

        // تعطيل زر الحذف إذا بقي صف واحد فقط
        function updateRemoveButtons() {
            const rows = document.querySelectorAll('.medicine-row');
            rows.forEach((row) => {
                const btn = row.querySelector('.remove-medicine');
                if (rows.length === 1) {
                    btn.setAttribute('disabled', 'true');
                } else {
                    btn.removeAttribute('disabled');
                }
            });
        }
    </script>
}