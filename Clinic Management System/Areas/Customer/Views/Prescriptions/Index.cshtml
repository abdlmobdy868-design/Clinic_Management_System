@model IEnumerable<ClinicManagementSystem.Models.Prescription>
@{
    ViewData["Title"] = "My Prescriptions";
}

<section class="page-head">
    <div class="container">
        <h2>My prescriptions</h2>
        <p>Medicines prescribed by your doctors</p>
    </div>
</section>

<div class="container py-4">
    @if (!Model.Any())
    {
        <div class="card-soft text-center text-muted">
            No prescriptions yet. They appear here after a doctor adds one to your visit.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var rx in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card-soft h-100 d-flex flex-column">
                        <div class="fw-bold mb-1"><i class="fas fa-prescription-bottle-medical me-2"></i>@rx.Date.ToString("dd MMM yyyy")</div>
                        <div class="text-muted mb-2">Dr. @(rx.MedicalRecord?.Doctor?.Name ?? "-")</div>
                        @if (!string.IsNullOrWhiteSpace(rx.Notes))
                        {
                            <p class="small mb-3">@rx.Notes</p>
                        }
                        <a asp-action="Details" asp-route-id="@rx.Id" class="btn btn-primary btn-sm mt-auto">View medicines</a>
                    </div>
                </div>
            }
        </div>
    }
</div>
