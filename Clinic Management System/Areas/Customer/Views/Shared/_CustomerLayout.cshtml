<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ClinicMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
</head>
<body class="cust-body">
    <nav class="navbar navbar-expand-lg cust-nav sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-area="Customer" asp-controller="Home" asp-action="Index">
                <i class="fas fa-heart-pulse"></i> ClinicMS
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#custNav" aria-label="Toggle navigation">
                <i class="fas fa-bars text-white"></i>
            </button>
            <div class="collapse navbar-collapse" id="custNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-area="Customer" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Customer" asp-controller="Doctors" asp-action="Index">Doctors</a></li>
                </ul>
                <div class="d-flex gap-2 align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (User.IsInRole(CD.ADMIN_ROLE) || User.IsInRole(CD.SUPER_ADMIN_ROLE))
                        {
                            <a class="btn btn-light btn-sm" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin dashboard</a>
                        }
                        <a class="btn btn-outline-light btn-sm" asp-area="Customer" asp-controller="Profile" asp-action="Index">@User.Identity!.Name</a>
                        
                        <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="Account" asp-action="Logout">Logout</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-light btn-sm" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="cust-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span><i class="fas fa-heart-pulse"></i> ClinicMS</span>
            <span class="opacity-75">&copy; @DateTime.Now.Year ClinicMS. All rights reserved.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
