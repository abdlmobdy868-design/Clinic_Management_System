@model IEnumerable<ClinicManagementSystem.Models.Review>
@{
    ViewData["Title"] = "My Reviews";
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">My Reviews</h5>
        <a asp-controller="Profile" asp-action="UserAppointment" class="btn btn-sm btn-outline-secondary">
            To review a doctor, open your completed appointments
        </a>
    </div>

    @if (!Model.Any())
    {
        <div style="background:#EDE8FF; border-radius:12px; padding:20px; text-align:center; color:#7A76A0;">No reviews yet.</div>
    }
    else
    {
        foreach (var r in Model)
        {
            <div class="mb-3" style="background:#fff; border:1.5px solid #B8B0E0; border-radius:12px; padding:16px 20px;">
                <div class="fw-semibold">@(r.Doctor?.Name ?? "Doctor")</div>
                <div style="color:#FFB400;">
                    @for (int i = 0; i < r.Rating; i++)
                    {
                        <span>★</span>
                    }
                </div>
                <p class="mt-2 mb-1">@r.Comment</p>
                <small style="color:#7A76A0;">@r.Date.ToShortDateString()</small>
            </div>
        }
    }
</div>
