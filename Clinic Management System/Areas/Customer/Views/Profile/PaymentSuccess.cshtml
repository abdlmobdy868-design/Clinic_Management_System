@model ClinicManagementSystem.Models.Appointment

@{
    ViewData["Title"] = "Payment Success";
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml"; // أو الـ Layout الخاص بالـ Customer
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-4 p-5">
                <div class="mb-4">
                    <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
                </div>
                <h1 class="text-success fw-bold mb-3">Thank You!</h1>
                <p class="text-muted fs-5 mb-4">Your payment was processed successfully and your appointment with <strong>Dr. @Model.Doctor?.Name</strong> has been confirmed.</p>

                <div class="alert alert-light border mb-4 text-start">
                    <p class="mb-1"><strong>Appointment ID:</strong> #@Model.Id</p>
                    <p class="mb-1"><strong>Date & Time:</strong> @Model.AppointmentDateTime.ToString("dd MMM yyyy - hh:mm tt")</p>
                    <p class="mb-0"><strong>Price:</strong> @Model.price EGP</p>
                </div>

                <!-- زرار الـ POST اللي هيودي على أكشن تاني -->
                <form asp-action="ConfirmPaymentPost" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm">
                        <i class="fas fa-home me-2"></i> Go to My Appointments
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>