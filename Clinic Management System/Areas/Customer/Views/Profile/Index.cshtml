@model ClinicManagementSystem.Models.Patient

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h3><i class="fas fa-user-circle me-2"></i> Patient Profile</h3>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Full Name:</div>
                        <div class="col-sm-8">@(Model.Name ?? "Not specified")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Phone:</div>
                        <div class="col-sm-8">@(Model.Phone ?? "Not specified")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Age:</div>
                        <div class="col-sm-8">@Model.Age</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Gender:</div>
                        <div class="col-sm-8">@Model.Gender</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Blood Type:</div>
                        <div class="col-sm-8">@(Model.BloodType ?? "Not specified")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Address:</div>
                        <div class="col-sm-8">@(Model.Address ?? "Not specified")</div>
                    </div>

                    <div class="text-end mt-4">
                        <a asp-action="Edit" class="btn btn-primary px-4"><i class="fas fa-edit me-1"></i> Edit Profile</a>
                        <a asp-action="UserAppointment" class="btn btn-primary px-4"><i class="fas fa-edit me-1"></i> Your Appointments</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>