@model IEnumerable<ClinicManagementSystem.Models.Appointment>
@using ClinicManagementSystem.Models
@{
    ViewData["Title"] = "My Appointments";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-primary text-white p-4 rounded-top-4 d-flex justify-content-between align-items-center">
                    <h3 class="mb-0"><i class="fas fa-calendar-alt me-2"></i> My Appointments</h3>
                    <a asp-area="Customer" asp-controller="Doctors" asp-action="Index" class="btn btn-light btn-sm px-3">
                        <i class="fas fa-plus me-1"></i> Book New Appointment
                    </a>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    @{ var currentStatus = ViewBag.Status as string; }
                    <div class="mb-3 d-flex flex-wrap gap-2">
                        <a asp-action="UserAppointment" class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-primary" : "btn-outline-primary")">All</a>
                        @foreach (var st in Enum.GetValues<AppointmentStatus>())
                        {
                            <a asp-action="UserAppointment" asp-route-status="@st" class="btn btn-sm @(currentStatus == st.ToString() ? "btn-primary" : "btn-outline-primary")">@st</a>
                        }
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-calendar-xmark fa-3x text-muted mb-3"></i>
                            <p class="text-muted fs-6">You don't have any appointments booked yet.</p>
                            <a asp-area="Customer" asp-controller="Doctors" asp-action="Index" class="btn btn-primary mt-2">Browse Doctors</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Doctor</th>
                                        <th>Clinic</th>
                                        <th>Date & Time</th>
                                        <th>Fee</th>
                                        <th>Status</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@(item.Doctor?.Name ?? "N/A")</td>
                                            <td>@(item.Clinic?.Name ?? "N/A")</td>
                                            <td>
                                                <div><i class="far fa-calendar-alt text-primary me-1"></i> @item.StartTime.ToString("dd MMM yyyy")</div>
                                                <small class="text-muted"><i class="far fa-clock me-1"></i> @item.StartTime.ToString("hh:mm tt") - @item.EndTime.ToString("hh:mm tt")</small>
                                            </td>
                                            <td class="fw-bold text-success">@item.price. EGP</td>
                                            <td>
                                                @if (item.Status == AppointmentStatus.Confirmed)
                                                {
                                                    <span class="badge bg-success">Confirmed</span>
                                                }
                                                else if (item.Status == AppointmentStatus.Cancelled)
                                                {

                                                    <span class="badge bg-danger">Cancelled</span>
                                                }
                                                else if (item.Status == AppointmentStatus.Completed)
                                                {

                                                    <span class="badge bg-primary">Completed</span>

                                                }
                                                else
                                                {

                                                    <span class="badge bg-warning text-dark">Pending</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (item.Status == AppointmentStatus.Pending || item.Status == AppointmentStatus.Confirmed)
                                                {
                                                    @if (item.Status == AppointmentStatus.Pending)
                                                    {
                                                        <form asp-action="Pay" asp-route-id="@item.Id" method="post" class="d-inline">
                                                            <button type="submit" class="btn btn-outline-success btn-sm px-3"><i class="fas fa-credit-card me-1"></i> Pay</button>
                                                        </form>
                                                    }
                                                    <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline ms-1">
                                                        <button type="submit" class="btn btn-outline-danger btn-sm px-3"><i class="fas fa-times me-1"></i> Cancel</button>
                                                    </form>
                                                    
                                                }
                                                else if (item.Status == AppointmentStatus.Completed)
                                                {
                                                    <div class="d-flex flex-column gap-1">
                                                        <a asp-area="Customer" asp-controller="MedicalRecords" asp-action="Index" asp-route-appointmentId="@item.Id" class="btn btn-sm" style="background:#EDE8FF; border:1px solid #B8B0E0; color:#3D3A5C;"><i class="fas fa-file-medical me-1"></i> Medical Record</a>
                                                        <a asp-area="Customer" asp-controller="LabResults" asp-action="Index" asp-route-appointmentId="@item.Id" class="btn btn-sm" style="background:#EDE8FF; border:1px solid #B8B0E0; color:#3D3A5C;"><i class="fas fa-vial me-1"></i> Lab Results</a>
                                                        <a asp-area="Customer" asp-controller="Reviews" asp-action="Create" asp-route-id="@item.Id" class="btn btn-sm" style="background:#3D3A5C; color:white;"><i class="fas fa-star me-1"></i> Leave Review</a>
                                                        <a asp-area="Customer" asp-controller="Prescriptions" asp-action="Index" asp-route-appointmentId="@item.Id" class="btn btn-sm" style="background:#EDE8FF; border:1px solid #B8B0E0; color:#3D3A5C;"><i class="fas fa-prescription-bottle-medical me-1"></i> Prescription</a>
                                                        @if (item.DoctorId != null)
                                                        {
                                                            <a asp-area="Customer" asp-controller="Doctors" asp-action="Details" asp-route-id="@item.DoctorId" class="btn btn-sm btn-outline-primary"><i class="fas fa-rotate-right me-1"></i> Book again</a>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    @if (item.DoctorId != null)
                                                {
                                                    <a asp-area="Customer" asp-controller="Doctors" asp-action="Details" asp-route-id="@item.DoctorId" class="btn btn-sm btn-outline-primary"><i class="fas fa-rotate-right me-1"></i> Book again</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No actions</span>
                                                }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>