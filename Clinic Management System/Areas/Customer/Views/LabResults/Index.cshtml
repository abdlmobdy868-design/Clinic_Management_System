@model IEnumerable<ClinicManagementSystem.Models.labResult>

@{
    ViewData["Title"] = "Lab Results";
}

<div class="container mt-4">
    <h4 class="mb-3">Lab Results</h4>

    @if (!Model.Any())
    {
        <div style="background:#EDE8FF; border:1.5px solid #B8B0E0; border-radius:12px; padding:30px; text-align:center;">
            <p class="text-muted">No lab results found.</p>
        </div>
    }
    else
    {
        <div class="row gap-3">
            @foreach (var item in Model)
            {
                <div class="col-md-5" style="background:#EDE8FF; border:1.5px solid #B8B0E0; border-radius:12px; padding:18px 24px;">
                    <div style="font-weight:600; color:#3D3A5C;">@item.LabTest.Name</div>
                    <small style="color:#7A76A0;">Date: @item.Date.ToShortDateString()</small>
                    <div class="mt-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm" style="background:#3D3A5C; color:white; border-radius:8px;">View / Download</a>
                    </div>
                </div>
            }
        </div>
    }
</div>