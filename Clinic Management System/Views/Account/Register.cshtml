@model ClinicManagementSystem.ViewModel.RegisterVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Register - Clinic System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
            body {
                background: #f0f7ff;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

            .card-reg {
                background: white;
                border-radius: 20px;
                box-shadow: 0 15px 50px rgba(0,100,255,0.1);
                overflow: hidden;
                width: 1000px;
                max-width: 100%;
                display: flex;
            }

            .left {
                flex: 1;
                padding: 40px;
            }

            .right {
                flex: 1;
                background: linear-gradient(135deg, #0d6efd, #00b4d8);
                color: white;
                padding: 40px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .form-control {
                border-radius: 10px;
                padding: 11px 15px;
            }

            .btn-reg {
                background: linear-gradient(135deg, #0d6efd, #00b4d8);
                border: none;
                border-radius: 10px;
                padding: 12px;
                width: 100%;
                color: white;
                font-weight: bold;
            }
    </style>
</head>
<body>
    <div class="card-reg">
        <div class="left">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <h3 class="fw-bold">Create Account</h3>
            <p class="text-muted">Join our clinic management system</p>
            <form asp-action="Register" method="post">
                <div class="mb-2"><label>UserName</label><input asp-for="UserName" class="form-control" placeholder="Ahmed" /></div>
                <div class="mb-2"><label>Full Name</label><input asp-for="FullName" class="form-control" placeholder="Dr. Ahmed Mohamed" /></div>
                <div class="mb-2"><label>Email</label><input asp-for="Email" class="form-control" placeholder="email@clinic.com" /></div>
                <div class="mb-2"><label>User Type</label><select asp-for="UserType" class="form-control"><option>Doctor</option><option>Receptionist</option><option>Admin</option></select></div>
                <div class="row">
                    <div class="col-6 mb-2"><label>Password</label><input asp-for="Password" type="password" class="form-control" required /></div>
                    <div class="col-6 mb-2"><label>Confirm</label><input asp-for="ConfirmPassword" type="password" class="form-control" required /></div>
                </div>
                <button type="submit" class="btn-reg mt-3">Register Now</button>
                <p class="text-center mt-3">Already have account? <a asp-action="Login">Login</a></p>
            </form>
        </div>
        <div class="right">
            <h2><i class="fas fa-hospital"></i> Clinic Management</h2>
            <h4 class="mt-3">Start Managing Today</h4>
            <p class="mt-3">The smartest way to manage appointments, patients, doctors, and billing. Made for graduation project to impress.</p>
            <ul class="mt-4 list-unstyled">
                <li><i class="fas fa-check-circle me-2"></i> Patient Management</li>
                <li><i class="fas fa-check-circle me-2"></i> Appointment Scheduling</li>
                <li><i class="fas fa-check-circle me-2"></i> Secure Role-Based Access</li>
            </ul>
        </div>
    </div>
</body>
</html>