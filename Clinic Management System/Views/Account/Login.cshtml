@model ClinicManagementSystem.ViewModel.LoginVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Login - Clinic System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
            body {
                background: #f0f7ff;
                font-family: 'Segoe UI';
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .login-card {
                background: white;
                border-radius: 20px;
                box-shadow: 0 15px 50px rgba(0,100,255,0.1);
                overflow: hidden;
                width: 900px;
                max-width: 95%;
                display: flex;
            }

            .left {
                background: linear-gradient(135deg, #0d6efd, #00b4d8);
                color: white;
                padding: 40px;
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .right {
                flex: 1.2;
                padding: 50px;
            }

            .form-control {
                border-radius: 10px;
                padding: 12px 15px;
                border: 1px solid #e0e0e0;
                margin-bottom: 15px;
            }

            .btn-login {
                background: linear-gradient(135deg, #0d6efd, #00b4d8);
                border: none;
                border-radius: 10px;
                padding: 12px;
                width: 100%;
                color: white;
                font-weight: bold;
            }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="left">
            <h1><i class="fas fa-heart-pulse"></i> ClinicMS</h1>
            <h3 class="mt-4">Welcome Back!</h3>
            <p>Manage your clinic, patients and appointments in one smart system.</p>
            <div class="mt-4"><i class="fas fa-shield-halved"></i> Secure & Trusted by Doctors</div>
        </div>
        <div class="right">
            <h3 class="fw-bold">Sign In</h3>
            <p class="text-muted mb-4">Login to your dashboard</p>
            <form asp-action="Login" method="post">
                <label>Email</label>
                <input asp-for="Email" class="form-control" placeholder="doctor@clinic.com" />
                <label>Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                <div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label class="form-check-label">Remember me</label></div>
                <button type="submit" class="btn-login">Login <i class="fas fa-arrow-right ms-2"></i></button>
                <p class="text-center mt-3">Don't have account? <a asp-action="Register">Register</a></p>
            </form>
        </div>
    </div>
</body>
</html>